        end if
        if [var_1] contains "denied" then
            return false
        end if
        if [var_1] contains "User interaction is not allowed" then
            return false
        end if
        if [var_1] contains "The specified item could not be found" then
            return false
        end if
        if (count [var_1]) < 8 then
            return false
        end if
        return true
    on error
        return false
    end try
end isValidSafeKey

